  "content": "<!DOCTYPE html>\n<html lang=\"vi\">\n\n<head>\n    <portlet name=\"cate_seo\"></portlet>\n\n    <link rel=\"preload\" as=\"style\" href=\"https://assets.tapchianninhmang.vn/encode/hoi_dap/desktop/output.css?v=20260623\">\n    <link rel=\"preload\" as=\"style\" href=\"https://assets.tapchianninhmang.vn/encode/common/style/law-hub-header.css?v=20260623\">\n    <link rel=\"preload\" as=\"style\" href=\"https://assets.tapchianninhmang.vn/encode/common/style/fonts-merriweather-vn.css?v=20260623\">\n    <link rel=\"preload\" as=\"style\" href=\"https://assets.tapchianninhmang.vn/encode/common/style/fonts-roboto-vn.css?v=20260623\">\n    <link rel=\"preload\" as=\"style\" href=\"https://assets.tapchianninhmang.vn/encode/common/style/common.css?v=20260623\">\n    <link rel=\"preload\" as=\"style\" href=\"https://assets.tapchianninhmang.vn/encode/common/style/icon.css?v=20260623\">\n    <link rel=\"preload\" as=\"style\" href=\"https://assets.tapchianninhmang.vn/encode/common/vendor/overlayscrollbars.min.css?v=20260623\">\n    <link rel=\"preload\" as=\"style\" href=\"https://assets.tapchianninhmang.vn/encode/common/style/overlayscrollbar.css?v=20260623\">\n    <link rel=\"preload\" as=\"style\" href=\"https://assets.tapchianninhmang.vn/encode/common/style/overlay.css?v=20260623\">\n    <link rel=\"preload\" as=\"style\" href=\"https://assets.tapchianninhmang.vn/encode/common/style/dropdown.css?v=20260623\">\n\n    <link rel=\"stylesheet\" href=\"https://assets.tapchianninhmang.vn/encode/hoi_dap/desktop/output.css?v=20260623\">\n    <link rel=\"stylesheet\" href=\"https://assets.tapchianninhmang.vn/encode/common/style/law-hub-header.css?v=20260623\">\n    <link rel=\"stylesheet\" href=\"https://assets.tapchianninhmang.vn/encode/common/style/fonts-merriweather-vn.css?v=20260623\">\n    <link rel=\"stylesheet\" href=\"https://assets.tapchianninhmang.vn/encode/common/style/fonts-roboto-vn.css?v=20260623\">\n    <link rel=\"stylesheet\" href=\"https://assets.tapchianninhmang.vn/encode/common/style/common.css?v=20260623\">\n    <link rel=\"stylesheet\" href=\"https://assets.tapchianninhmang.vn/encode/common/style/icon.css?v=20260623\">\n    <link rel=\"stylesheet\" href=\"https://assets.tapchianninhmang.vn/encode/common/vendor/overlayscrollbars.min.css?v=20260623\">\n    <link rel=\"stylesheet\" href=\"https://assets.tapchianninhmang.vn/encode/common/style/overlayscrollbar.css?v=20260623\">\n    <link rel=\"stylesheet\" href=\"https://assets.tapchianninhmang.vn/encode/common/style/overlay.css?v=20260623\">\n    <link rel=\"stylesheet\" href=\"https://assets.tapchianninhmang.vn/encode/common/style/dropdown.css?v=20260623\">\n\n    <portlet name=\"ga4\"></portlet>\n</head>\n\n<body class=\"\">\n    <portlet name=\"page_info\"></portlet>\n    <portlet name=\"clamp-text-js\"></portlet>\n    <portlet name=\"link-prefetch\"></portlet>\n    <portlet name=\"d_header_no_menu\"></portlet>\n    <portlet name=\"m_header\"></portlet>\n\n    <section class=\"qa-page-section t:bg-linear-to-b t:from-[#E5F3FF] t:to-[#F6FBFF] t:py-5\">\n        <div class=\"t:container\">\n            <portlet name=\"law_hub_header\"></portlet>\n            <div class=\"qa-grid t:grid t:grid-cols-[2fr_1fr] t:gap-x-8 t:items-start\">\n\n                <!-- ============ LEFT: questions table ============ -->\n                <portlet name=\"hoi_dap_questions\"></portlet>\n\n                <!-- ============ RIGHT: related articles (secondary) ============ -->\n                <portlet name=\"hoi_dap_related\"></portlet>\n\n            </div>\n\n                <!-- Q&A answer popup -->\n                <div class=\"qa-modal\" id=\"qa-modal\" hidden>\n                    <div class=\"qa-modal__backdrop\" data-qa-close></div>\n                    <div class=\"qa-modal__dialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"qa-modal-q\">\n                        <button type=\"button\" class=\"qa-modal__close\" data-qa-close aria-label=\"Đóng\">✕</button>\n                        <h3 class=\"qa-modal__q\" id=\"qa-modal-q\"></h3>\n                        <div class=\"qa-modal__a\" id=\"qa-modal-a\"></div>\n                    </div>\n                </div>\n\n                <script>\n                    (function () {\n                        const modal = document.getElementById('qa-modal');\n                        if (!modal) return;\n                        const dialog = modal.querySelector('.qa-modal__dialog');\n                        const elQ = document.getElementById('qa-modal-q');\n                        const elA = document.getElementById('qa-modal-a');\n                        let closeTimer = null;\n\n                        function openModal(row) {\n                            elQ.textContent = row.dataset.question || '';\n                            elA.innerHTML = '';\n                            (row.dataset.answer || '').split('\\n').forEach(function (line) {\n                                line = line.trim();\n                                if (!line) return;\n                                var p = document.createElement('p');\n                                p.textContent = line;\n                                p.style.cssText = 'margin:0 0 0.7em;text-indent:1.5em;line-height:1.7;';\n                                elA.appendChild(p);\n                            });\n                            if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }\n                            modal.hidden = false;\n                            document.body.style.overflow = 'hidden';\n                            // force reflow so the transition runs\n                            void modal.offsetWidth;\n                            modal.classList.add('is-open');\n                            dialog.scrollTop = 0;\n                        }\n\n                        function closeModal() {\n                            modal.classList.remove('is-open');\n                            document.body.style.overflow = '';\n                            closeTimer = setTimeout(function () { modal.hidden = true; }, 300);\n                        }\n\n                        document.addEventListener('click', function (e) {\n                            const row = e.target.closest('[data-qa-row]');\n                            if (row) { openModal(row); return; }\n                            if (e.target.closest('[data-qa-close]')) closeModal();\n                        });\n\n                        document.addEventListener('keydown', function (e) {\n                            if (e.key === 'Escape' && !modal.hidden) closeModal();\n                            // keyboard activation of a focused row\n                            if ((e.key === 'Enter' || e.key === ' ')) {\n                                const row = e.target.closest && e.target.closest('[data-qa-row]');\n                                if (row) { e.preventDefault(); openModal(row); }\n                            }\n                        });\n                    })();\n                </script>\n\n                <script>\n                    // Match the questions table height to the related-articles sidebar (desktop only).\n                    (function () {\n                        const wrap = document.querySelector('.qa-table-wrap');\n                        const sidebar = document.querySelector('.qa-sidebar');\n                        const main = document.querySelector('.qa-main');\n                        if (!wrap || !sidebar || !main) return;\n\n                        function sync() {\n                            // Stacked layout (<=1024px): fall back to the CSS max-height.\n                            if (window.matchMedia('(max-width: 1024px)').matches) {\n                                wrap.style.maxHeight = '';\n                                return;\n                            }\n                            const headerOffset = wrap.getBoundingClientRect().top - main.getBoundingClientRect().top;\n                            const h = sidebar.offsetHeight - headerOffset;\n                            wrap.style.maxHeight = Math.max(320, Math.round(h)) + 'px';\n                        }\n\n                        window.addEventListener('resize', sync);\n                        window.addEventListener('load', sync);\n                        // Sidebar images change its height once loaded — recompute then.\n                        document.querySelectorAll('.qa-sidebar img').forEach(function (img) {\n                            if (!img.complete) img.addEventListener('load', sync, { once: true });\n                        });\n                        sync();\n                    })();\n                </script>\n        </div>\n    </section>\n\n    <portlet name=\"footer\"></portlet>\n\n    <script type=\"module\" src=\"https://assets.tapchianninhmang.vn/encode/common/overlayscrollbar.js\"></script>\n    <script type=\"module\" src=\"https://assets.tapchianninhmang.vn/encode/common/floating-dropdown.js\"></script>\n    <script type=\"module\" src=\"https://assets.tapchianninhmang.vn/encode/common/overlay.js\"></script>\n    <script type=\"module\" src=\"https://assets.tapchianninhmang.vn/encode/common/header-sticky.js\"></script>\n</body>\n\n</html>",
