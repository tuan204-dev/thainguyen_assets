  "id": 265,
  "name": "Video_Detail_New",
  "layout_type_id": 1,
  "is_default": false,
  "is_mobile": false,
  "status_id": 2,
  "content": "<!doctype html>\n<html lang=\"en\">\n    <head>\n        <meta charset=\"UTF-8\" />\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n\n        <portlet name=\"detail_head_seo\"></portlet>\n\n        <link rel=\"stylesheet\" href=\"https://r2-thainguyen.media-soft.cloud/detail_video/desktop/output.css\" />\n        <link rel=\"stylesheet\" href=\"https://r2-thainguyen.media-soft.cloud/common/style/fonts-noto-serif-vn.css\" />\n        <link rel=\"stylesheet\" href=\"https://r2-thainguyen.media-soft.cloud/common/style/fonts-roboto-vn.css\" />\n        <link rel=\"stylesheet\" href=\"https://r2-thainguyen.media-soft.cloud/common/style/common.css\" />\n        <link rel=\"stylesheet\" href=\"https://r2-thainguyen.media-soft.cloud/common/style/icon.css\" />\n        <link rel=\"stylesheet\" href=\"https://r2-thainguyen.media-soft.cloud/common/style/overlay.css\" />\n\n        <style>\n            @media (min-width: 1000px) and (max-width: 1099px) {\n                #desktop-cate-list > *:nth-child(n + 10) {\n                    display: none;\n                }\n            }\n\n            @media (min-width: 1100px) and (max-width: 1199px) {\n                #desktop-cate-list > *:nth-child(n + 11) {\n                    display: none;\n                }\n            }\n\n            @media (min-width: 1200px) {\n                #desktop-cate-list > *:nth-child(n + 12) {\n                    display: none;\n                }\n            }\n        </style>\n    </head>\n\n    <body class=\"home-page\">\n        <portlet name=\"detail_page_info\"></portlet>\n        <portlet name=\"clamp-text-js\"></portlet>\n        <portlet name=\"lazy-images\"></portlet>\n        <portlet name=\"link-prefetch\"></portlet>\n\n        <portlet name=\"header\"></portlet>\n\n        <main class=\"roboto t:bg-white\">\n            <portlet name=\"detail_info\"></portlet>\n\n            <section class=\"detail-main-wrapper t:bg-white t:py-5\">\n                <div class=\"t:container t:mx-auto\">\n                    <div\n                        class=\"t:grid t:grid-cols-1 t:gap-8 t:pc:grid-cols-[minmax(0,2fr)_minmax(18rem,0.95fr)]\"\n                    >\n                        <div class=\"t:min-w-0\">\n                            <portlet name=\"detail_content\"></portlet>\n                        </div>\n\n                        <aside\n                            class=\"t:min-w-0 t:border-t t:border-[#E5E7EB] t:pt-6 t:pc:border-t-0 t:pc:pt-0\"\n                        >\n                            <portlet name=\"detai_share_tag\"></portlet>\n                        </aside>\n                    </div>\n\n                    <portlet name=\"video_detail_cate_sections\"></portlet>\n                </div>\n            </section>\n        </main>\n\n        <portlet name=\"footer\"></portlet>\n        <portlet name=\"event_count\"></portlet>\n\n        <button\n            type=\"button\"\n            id=\"scrollToTopBtn\"\n            aria-label=\"Lên đầu trang\"\n            class=\"t:hidden t:md:block\"\n            style=\"\n                position: fixed;\n                right: 24px;\n                bottom: 24px;\n                width: 44px;\n                height: 44px;\n                border: none;\n                border-radius: 9999px;\n                background: #30a14a;\n                color: #fff;\n                display: none;\n                align-items: center;\n                justify-content: center;\n                cursor: pointer;\n                font-size: 18px;\n                line-height: 1;\n                z-index: 120;\n                box-shadow: 0 8px 24px rgba(10, 100, 180, 0.35);\n                opacity: 0;\n                transform: translateY(8px);\n                transition:\n                    opacity 0.25s ease,\n                    transform 0.25s ease,\n                    background-color 0.25s ease;\n            \"\n        >\n            ↑\n        </button>\n\n        <script>\n            (function () {\n                const scrollToTopBtn = document.getElementById(\"scrollToTopBtn\");\n                if (!scrollToTopBtn) return;\n\n                const toggleVisibility = () => {\n                    const isVisible = window.scrollY > 280;\n                    if (isVisible) {\n                        if (scrollToTopBtn.style.display !== \"flex\") {\n                            scrollToTopBtn.style.display = \"flex\";\n                            requestAnimationFrame(() => {\n                                scrollToTopBtn.style.opacity = \"1\";\n                                scrollToTopBtn.style.transform = \"translateY(0)\";\n                            });\n                        }\n                    } else {\n                        scrollToTopBtn.style.opacity = \"0\";\n                        scrollToTopBtn.style.transform = \"translateY(8px)\";\n                        setTimeout(() => {\n                            if (window.scrollY <= 280) {\n                                scrollToTopBtn.style.display = \"none\";\n                            }\n                        }, 250);\n                    }\n                };\n\n                window.addEventListener(\"scroll\", toggleVisibility, { passive: true });\n                scrollToTopBtn.addEventListener(\"click\", () => {\n                    window.scrollTo({ top: 0, behavior: \"smooth\" });\n                });\n\n                scrollToTopBtn.addEventListener(\"mouseenter\", () => {\n                    scrollToTopBtn.style.background = \"#268D3F\";\n                });\n\n                scrollToTopBtn.addEventListener(\"mouseleave\", () => {\n                    scrollToTopBtn.style.background = \"#30A14A\";\n                });\n\n                toggleVisibility();\n            })();\n        </script>\n\n        <script src=\"https://r2-thainguyen.media-soft.cloud/common/common.js\"></script>\n        <script type=\"module\" src=\"https://r2-thainguyen.media-soft.cloud/common/floating-dropdown.js\"></script>\n        <script type=\"module\" src=\"https://r2-thainguyen.media-soft.cloud/common/overlay.js\"></script>\n        <script type=\"module\" src=\"https://r2-thainguyen.media-soft.cloud/common/header-sticky.js\"></script>\n        <script type=\"module\" src=\"https://r2-thainguyen.media-soft.cloud/common/header.js\"></script>\n        <script type=\"module\" src=\"https://r2-thainguyen.media-soft.cloud/detail_video/desktop/script/index.js\"></script>\n    </body>\n</html>\n"
}