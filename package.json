{
  "name": "tcann-assets",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "tw:cate:desktop": "tailwindcss -i ./cate/desktop/source.css -o ./cate/desktop/output.css --watch",
    "tw:cate:mobile": "tailwindcss -i ./cate/mobile/source.css -o ./cate/mobile/output.css --watch",
    "tw:detail:desktop": "tailwindcss -i ./detail/desktop/source.css -o ./detail/desktop/output.css --watch",
    "tw:detail:mobile": "tailwindcss -i ./detail/mobile/source.css -o ./detail/mobile/output.css --watch",
    "tw:home:desktop": "tailwindcss -i ./home/desktop/source.css -o ./home/desktop/output.css --watch",
    "tw:home:mobile": "tailwindcss -i ./home/mobile/source.css -o ./home/mobile/output.css --watch",
    "tw:centered:desktop": "tailwindcss -i ./centered/desktop/source.css -o ./centered/desktop/output.css --watch",
    "tw:magazine:desktop": "tailwindcss -i ./magazine/desktop/source.css -o ./magazine/desktop/output.css --watch",
    "tw:search:desktop": "tailwindcss -i ./search/desktop/source.css -o ./search/desktop/output.css --watch",
    "tw:gnc:desktop": "tailwindcss -i ./goc-nhin-chuyen-gia/desktop/source.css -o ./goc-nhin-chuyen-gia/desktop/output.css --watch",
    "tw:rss:desktop": "tailwindcss -i ./rss/desktop/source.css -o ./rss/desktop/output.css --watch",
    "url": "bun a_script/build_url.ts",
    "format": "prettier --write \"**/*.{html,css,js,ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,ts,json,md}\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "latest",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.2.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@floating-ui/dom": "1.6.13",
    "overlayscrollbars": "2.10.1",
    "swiper": "11"
  }
}
